# Telegram bot token from BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs. Required; an empty allowlist denies everyone.
TELEGRAM_ALLOWED_USER_IDS=

# Optional comma-separated chat IDs. Leave empty to authorize by user ID only.
TELEGRAM_ALLOWED_CHAT_IDS=

# Reject group chats by default. Set to 0 only if group operation is intentional.
TELEGRAM_PRIVATE_ONLY=1

# Absolute path to the AGY binary and the default workspace it uses.
AGY_BIN=/usr/local/bin/agy
AGY_WORKSPACE=/srv/agy-workspaces/default

# Optional base directory for discovering and scoping project directories via /workspace.
# Defaults to the parent directory of AGY_WORKSPACE if omitted.
# AGY_PROJECTS_ROOT=/srv/agy-workspaces

# Optional AGY project identifier. Leave empty to use AGY's default project.
AGY_PROJECT=

# Optional path to AGY SQLite conversation summaries database.
# AGY_DB_PATH=/var/lib/agybot/.gemini/antigravity-cli/conversation_summaries.db

# Full-control defaults. Restrict TELEGRAM_ALLOWED_USER_IDS to trusted users.
AGY_MODE=plan
AGY_SANDBOX=0
AGY_ALLOW_SANDBOX_DISABLE=1
AGY_MODEL=
AGY_EFFORT=high
AGY_AGENT=
# Automatically approve AGY tool permissions for normal prompts.
AGY_ALLOW_DANGEROUSLY_SKIP_PERMISSIONS=1
# Optional comma-separated model allowlist used by /models and /model.
# AGY_ALLOWED_MODELS=gemini-3.7-flash-high,gemini-3.6-flash-high,gemini-3.1-pro-high,claude-sonnet-4-6

# Process and Telegram limits tuned for a small VPS.
AGY_TIMEOUT_MS=1800000
AGY_MAX_OUTPUT_BYTES=20000000
TELEGRAM_MAX_MESSAGE_CHARS=3900
MAX_QUEUE_SIZE=8

# Default /menu profile: mixed, daily, dev
# Defaults to 'mixed' if omitted.
MENU_PROFILE=mixed

# State is intentionally outside the repository.
STATE_FILE=/var/lib/agy-telegram/state.json
TEMP_DIR=/var/lib/agy-telegram/tmp
LOG_LEVEL=info

# Speech-to-Text (STT) Voice Note Transcription
# Providers: none, whisper-local, gemini, agy
STT_PROVIDER=none
STT_WHISPER_BIN=whisper
STT_WHISPER_MODEL=base
# STT_GEMINI_API_KEY=
STT_GEMINI_MODEL=gemini-2.5-flash
STT_AGY_MODEL=gemini-3.8-flash-low
STT_LANGUAGE=en
STT_TIMEOUT_MS=20000
TELEGRAM_STT_SHOW_TRANSCRIPT=1

# Text-to-Speech (TTS) Voice Responses (edge-tts + ffmpeg)
# Modes: off, auto, voice-only, voice-and-text
TTS_MODE=off
TTS_VOICE=en-US-AndrewMultilingualNeural
TTS_BIN=/usr/local/bin/edge-tts
TTS_TIMEOUT_MS=25000
